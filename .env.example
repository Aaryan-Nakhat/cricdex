# Copy to .env and fill in what you use. Everything here is optional:
# metrics, ratings, scout, auction and the site need no keys at all.

# LLM — only for the player-taxonomy enrichment (scripts/enrich_taxonomy.py).
# Any provider LiteLLM supports; the model string picks it: <provider>/<model>
LLM_MODEL=
# The provider's key goes in the variable LiteLLM documents for that provider,
# or set these to override the key / endpoint (a self-hosted or custom server):
LLM_API_KEY=
LLM_API_BASE=

# Where CricDex keeps config + data (default ~/.cricdex).
# CRICDEX_HOME=
