# LLMs
LLM_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
JINA_API_KEY=
COHERE_API_KEY=

# HuggingFace — personal token. Required for sentence-transformers
# / model downloads. Process-scoped via .env so it does not touch the shared
# ~/.cache/huggingface/token (which may hold another account).
HF_TOKEN=

# LLM — points at an external /generate, /generate_json
# endpoint (optional).
LLM_API_BASE=
LLM_API_KEY=

# Vector DB
QDRANT_URL=
QDRANT_API_KEY=

# Relational
DATABASE_URL=postgresql://localhost:5432/cricdex
DUCKDB_PATH=data/cricdex.duckdb

# Redis / cache
REDIS_URL=redis://localhost:6379/0

# Graph (later)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Reddit (pulse module)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=cricdex/0.1 by u/your_handle

# Bots
TELEGRAM_BOT_TOKEN=

# Resend — daily-digest email send. Sign up at https://resend.com
# (free tier 3,000 emails/month). RESEND_FROM must be a verified
# sender on your account; the default uses Resend's onboarding
# sandbox so the digest works without DNS setup.
RESEND_API_KEY=
RESEND_FROM=CricDex Digest <onboarding@resend.dev>

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
