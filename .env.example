# LLMs
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
JINA_API_KEY=
COHERE_API_KEY=

# HuggingFace — personal token (NOT work). Required for sentence-transformers
# / model downloads. Process-scoped via .env so it does not touch the shared
# ~/.cache/huggingface/token (which may still hold a work account).
HF_TOKEN=

# Vector DB
QDRANT_URL=
QDRANT_API_KEY=

# Relational
DATABASE_URL=postgresql://localhost:5432/cricdex
DUCKDB_PATH=data/cricdex.duckdb

# Redis / cache
REDIS_URL=redis://localhost:6379/0

# Graph (later)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Reddit (pulse module)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=cricdex/0.1 by u/your_handle

# Bots
TELEGRAM_BOT_TOKEN=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
