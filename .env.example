# Copy to .env and fill in what you use. Everything here is optional:
# metrics, ratings, scout, auction and the site need no keys at all.

# LLM — only for the player-taxonomy enrichment (scripts/enrich_taxonomy.py).
# Any provider LiteLLM supports; the model string picks it, e.g.
#   openai/gpt-4o-mini · anthropic/claude-sonnet-4-5 · llm/llm-model · ollama/llama3.1
LLM_MODEL=
# The provider's key goes in its usual variable (LiteLLM reads it), e.g.
#   OPENAI_API_KEY= · ANTHROPIC_API_KEY= · LLM_API_KEY=
# or set these to override the key / endpoint (self-hosted or OpenAI-compatible server):
LLM_API_KEY=
LLM_API_BASE=

# Where CricDex keeps config + data (default ~/.cricdex).
# CRICDEX_HOME=
