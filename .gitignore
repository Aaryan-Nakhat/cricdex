# Data (raw + processed — too big for git)
data/*
!data/.gitkeep
!data/README.md
!data/rules/
data/rules/*
!data/rules/curated/
!data/drs/
data/drs/*
!data/drs/scenarios.jsonl
# Curated player facts (role / country from the taxonomy, DOB / photo from Wikidata): small, slow to rebuild,
# and needed by the refresh workflow — committed so a refresh on a fresh runner keeps them.
!data/curated/
data/curated/*
!data/curated/player_taxonomy.json
!data/curated/wikidata_enrichment.json
# The player master (scripts/build_player_master.py): its cached open-data lookups, the LLM name
# check, the reviewed overrides, the 2026 IPL squads, the built master and its review file.
!data/curated/player_overrides.json
# player_master.json + player_master_review.json are derived: scripts/build_player_master.py --no-fetch
!data/curated/player_names_llm.json
!data/curated/wikidata_players.json
!data/curated/wikipedia_infobox.json
!data/curated/international_caps.json
!data/curated/ipl_squads_2026.json
*.parquet
*.duckdb
*.duckdb.wal
*.csv.gz
